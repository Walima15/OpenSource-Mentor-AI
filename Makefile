# OpenSource Mentor AI - common developer tasks
# Usage: make <target>

COMPOSE := docker compose

.PHONY: help
help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
.PHONY: up
up: ## Build and start all services
	$(COMPOSE) up --build

.PHONY: up-d
up-d: ## Start all services in the background
	$(COMPOSE) up --build -d

.PHONY: down
down: ## Stop all services
	$(COMPOSE) down

.PHONY: logs
logs: ## Tail logs from all services
	$(COMPOSE) logs -f

.PHONY: migrate
migrate: ## Apply database migrations inside the api container
	$(COMPOSE) exec agent-api alembic upgrade head

.PHONY: revision
revision: ## Create a new autogenerated migration (msg="...")
	$(COMPOSE) exec agent-api alembic revision --autogenerate -m "$(msg)"

# ---------------------------------------------------------------------------
# Backend (local)
# ---------------------------------------------------------------------------
.PHONY: api-install
api-install: ## Install backend deps locally
	cd services/agent-api && pip install -r requirements.txt

.PHONY: api-dev
api-dev: ## Run the FastAPI server locally with reload
	cd services/agent-api && uvicorn app.main:app --reload --port 8000

.PHONY: worker
worker: ## Run the Arq background worker locally (requires REDIS_URL)
	cd services/agent-api && arq app.worker.WorkerSettings

.PHONY: api-test
api-test: ## Run backend tests (local; needs requirements-dev.txt installed)
	cd services/agent-api && pytest

.PHONY: api-test-docker
api-test-docker: ## Run backend tests in a throwaway container (no local Python needed)
	docker compose run --rm -v "$(CURDIR)/services/agent-api:/app" agent-api \
		sh -c "pip install -q -r requirements-dev.txt && pytest -q"

.PHONY: api-lint
api-lint: ## Lint backend
	cd services/agent-api && ruff check app

# ---------------------------------------------------------------------------
# Frontend (local)
# ---------------------------------------------------------------------------
.PHONY: web-install
web-install: ## Install frontend deps locally
	cd apps/web && npm install

.PHONY: web-dev
web-dev: ## Run the Next.js dev server
	cd apps/web && npm run dev

.PHONY: web-build
web-build: ## Build the Next.js app
	cd apps/web && npm run build

.PHONY: web-lint
web-lint: ## Lint frontend
	cd apps/web && npm run lint
