# OSMA environment. Copy to .env in the repository root.
# The API reads this file. Do not commit .env.

# OpenAI-compatible chat completions. Leave the key empty to use guide mode:
# the curriculum, project guides, and GitHub tools still work.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional. Raises the GitHub API rate limit. Never commit a real token.
# Fine-grained or classic PATs both work. Public read access is enough.
GITHUB_TOKEN=

# SQLite file. The default path is relative to services/agent-api when you
# run `make dev`. Docker Compose overrides this to /data/osma.db.
DATABASE_URL=sqlite:///./data/osma.db

# Comma-separated browser origins allowed to call the API directly.
# The web app proxies through Next.js, so you only need this for curl or /docs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Per-process request limits. In-memory, so they reset when the API restarts.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_READ_PER_MINUTE=120

# Tool-calling rounds per chat turn.
MAX_TOOL_ROUNDS=4

# Used by the Next.js server when it proxies to the API.
# Local: http://127.0.0.1:8000  Docker Compose sets http://agent-api:8000.
# Allowed hosts: localhost, 127.0.0.1, agent-api.
AGENT_API_URL=http://127.0.0.1:8000
