# ============================================================================
# OpenSource Mentor AI - environment configuration
# Copy this file to .env and fill in the values.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase (Auth + Postgres)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Public anon key (safe for the browser)
SUPABASE_ANON_KEY=
# Service role key (server-side ONLY, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to validate Supabase session tokens in FastAPI
# (Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string used by FastAPI / Alembic.
# Supabase: postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Local compose: postgresql+psycopg://osma:osma@postgres:5432/osma
DATABASE_URL=postgresql+psycopg://osma:osma@localhost:5432/osma

# ---------------------------------------------------------------------------
# Anthropic (LLM)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Default model used by the agent system
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------------
# GitHub OAuth app (used by Supabase provider + server-side API calls)
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: a fallback PAT for unauthenticated/server tasks (higher rate limits)
GITHUB_FALLBACK_TOKEN=

# ---------------------------------------------------------------------------
# Qdrant (vector database)
# ---------------------------------------------------------------------------
# Local compose: http://qdrant:6333  | Local dev: http://localhost:6333
QDRANT_URL=http://localhost:6333
# Only required for Qdrant Cloud
QDRANT_API_KEY=
QDRANT_COLLECTION=osma_repo_chunks

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Provider for embeddings: "fastembed" (local, default) or "openai"
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Vector dimension must match the embedding model (bge-small-en-v1.5 = 384)
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32-byte url-safe base64 key for encrypting stored GitHub tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Background queue (optional)
# ---------------------------------------------------------------------------
# When set, repo ingestion runs on a durable Arq worker instead of in-process.
# Local compose: redis://redis:6379 | Local dev: redis://localhost:6379
# Leave blank to use FastAPI BackgroundTasks (no Redis required).
REDIS_URL=

# ---------------------------------------------------------------------------
# Service URLs / CORS
# ---------------------------------------------------------------------------
# Where the FastAPI service lives (used by the web app, server-side)
AGENT_API_URL=http://localhost:8000
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Environment name: development | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Next.js frontend (NEXT_PUBLIC_* are exposed to the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the FastAPI service as reachable from the browser
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
